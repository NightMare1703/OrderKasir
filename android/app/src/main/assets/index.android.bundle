 required",errNumber:"Required, digits only without separators",errBarcodeDuplicate:"Barcode is already used by another product. Use a different one",errGeneric:"Some data is missing. Please review the form",deleteConfirmTitle:"Delete product?",deleteConfirmBody:"\"{{name}}\" will be hidden from the list and the cashier"},inventory:{},customers:{title:"Debts"},shift:{},reports:{},settings:{},errors:{}}},522,[]);
